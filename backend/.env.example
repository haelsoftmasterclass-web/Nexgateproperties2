DJANGO_DEBUG=false
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=api.example.com
DJANGO_ADMIN_PATH=manage-nexgate/
API_PUBLIC_URL=https://api.example.com

POSTGRES_DB=nexgate
POSTGRES_USER=nexgate
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_SSLMODE=prefer

CORS_ALLOWED_ORIGINS=https://www.example.com
CSRF_TRUSTED_ORIGINS=https://api.example.com
API_NUM_PROXIES=1
API_THROTTLE_ANON=120/min
API_THROTTLE_ENQUIRIES=5/hour

# Shared secret sent by the Next.js server with each enquiry
ENQUIRY_API_KEY=
# Next.js on-demand revalidation
FRONTEND_REVALIDATE_URL=https://www.example.com/api/revalidate
REVALIDATE_SECRET=

SITE_URL=https://www.example.com
MEDIA_PUBLIC_BASE_URL=
DJANGO_MEDIA_ROOT=
MAX_IMAGE_UPLOAD_BYTES=8388608

# Email notifications for new enquiries (optional; leave EMAIL_HOST blank to disable)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=
ENQUIRY_NOTIFICATION_EMAILS=

REDIS_URL=
DJANGO_LOG_LEVEL=INFO
