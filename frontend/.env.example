# Server-side URL of the Django API (never exposed to browsers)
API_URL=http://localhost:8000
# Public URL of this website, used for canonical URLs, sitemap and Open Graph
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: public base URL for media files if served from a CDN (defaults to API_URL)
MEDIA_PUBLIC_BASE_URL=
# Cache lifetime for API data in seconds
API_REVALIDATE_SECONDS=300
# Must match ENQUIRY_API_KEY in the backend. Required in production.
ENQUIRY_API_KEY=
# Must match REVALIDATE_SECRET in the backend, to refresh pages after admin edits
REVALIDATE_SECRET=
# Set to "true" ONLY on the live production domain. Anything else blocks search engines.
ALLOW_INDEXING=false
